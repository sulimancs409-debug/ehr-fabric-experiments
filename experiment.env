# ---- Experiment factors (edit here; everything else reads this file) ----
# "Block size" factor: Fabric cuts a block when ANY of these is hit first:
#   MaxMessageCount, PreferredMaxBytes, or BatchTimeout.
# Our anchor transactions are ~0.5 KB, so MaxMessageCount is the factor that
# actually controls block size here. PreferredMaxBytes is set high so that it
# never triggers first. BatchTimeout is fixed and reported in the paper.
BLOCK_MSG_LEVELS="10 50 100 250"
BATCH_TIMEOUT="500ms"
PREFERRED_MAX_BYTES="3 MB"
ABSOLUTE_MAX_BYTES="99 MB"

# "Concurrent clients" factor = total in-flight transactions (fixed-load controller)
CLIENT_LEVELS="10 50 100 200"
WORKERS=2                 # Caliper worker processes (clients are split across them)

REPS=5                    # repetitions per condition
TX_DURATION=60            # seconds per round
PRELOAD_PER_WORKER=200    # records created before the read round
COOLDOWN=15               # seconds between runs
RESTART_EACH_BLOCK_LEVEL=1  # fresh network (and empty ledger) for each block level

# ---- Paths (adjust if your layout differs) ----
KIT_DIR="$HOME/ehr-kit"
TEST_NETWORK="$HOME/ehr-fabric/fabric-samples/test-network"
CHANNEL="mychannel"
CC_NAME="ehr"
